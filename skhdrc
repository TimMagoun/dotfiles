# Services
alt + shift - z : brew services restart yabai
alt + shift - x : skhd -r

# change focus
alt - h : yabai -m window --focus stack.prev || yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus stack.next || yabai -m window --focus east

# shift window in current workspace
alt + shift - h : yabai -m window --warp west || $(yabai -m window --display west; yabai -m display --focus west)
alt + shift - j : yabai -m window --warp south || $(yabai -m window --display south; yabai -m display --focus south)
alt + shift - k : yabai -m window --warp north || $(yabai -m window --display north; yabai -m display --focus north)
alt + shift - l : yabai -m window --warp east || $(yabai -m window --display east; yabai -m display --focus east)

# set insertion point in focused container
ctrl + alt - h : yabai -m window --resize right:-20:0 || yabai -m window --resize left:-20:0
ctrl + alt - j : yabai -m window --resize bottom:0:20 || yabai -m window --resize top:0:20
ctrl + alt - k : yabai -m window --resize top:0:-20 || yabai -m window --resize bottom:0:-20
ctrl + alt - l : yabai -m window --resize left:20:0 || yabai -m window --resize right:20:0
# go back to previous workspace (kind of like back_and_forth in i3)
# alt - p : yabai -m space --focus recent

# move focused window to previous workspace
alt + shift - p : yabai -m window --space recent

# move focused window to next/prev workspace
alt + shift - 1 : yabai -m window --space 1
alt + shift - 2 : yabai -m window --space 2
alt + shift - 3 : yabai -m window --space 3
alt + shift - 4 : yabai -m window --space 4
alt + shift - 5 : yabai -m window --space 5
alt + shift - 6 : yabai -m window --space 6
alt + shift - 7 : yabai -m window --space 7
alt + shift - 8 : yabai -m window --space 8
alt + shift - 9 : yabai -m window --space 9

# balance the size of windows
alt + shift - 0 : yabai -m space --balance

# change layout of desktop
alt - b : yabai -m space --layout bsp
alt - s : yabai -m space --layout stack
alt - v : yabai -m space --layout float

# close focused window
alt + shift - q: yabai -m window --close

# enter (f)ullscreen mode for the focused container
alt - f : yabai -m window --toggle zoom-fullscreen
# toggle window native (f)ullscreen
alt + shift - f : yabai -m window --toggle native-fullscreen
# toggle window floatin(g)
alt - g : yabai -m window --toggle float
# alt + shift - g : yabai -m space --layout float
# toggle window split/(o)rientation
alt - o : yabai -m window --toggle split
# Open terminal
alt - t : /Applications/Term.app/Contents/MacOS/alacritty -e tmux
